{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/*"],
      "@deskhand/core": ["../../packages/core/src"],
      "@deskhand/shared": ["../../packages/shared/src"],
      "@deskhand/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
